# Dependencies
node_modules/

# Environment variables - NEVER commit these
.env
.env.local
.env.production

# Build outputs
dist/
build/

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# pnpm
.pnpm-store/
*:Zone.Identifier

# Player uploads (avatars): live data, not source. Back these up.
apps/server/uploads/

# Source art lives in art/; anything in public/ is published to the site
apps/client/public/**/*.psd

# Raw icon art waiting for pnpm icons:make (apps/server/src/scripts/makeIcons.ts): the
# finished icons land in apps/client/public/images/items, which is what gets committed.
design/icon-inbox/
